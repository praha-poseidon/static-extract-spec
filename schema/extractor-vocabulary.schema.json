{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://static-extract.dev/schema/extractor-vocabulary.schema.json",
  "title": "Static Extract Extractor Vocabulary",
  "description": "Machine-readable free-atom vocabulary for one extractor. Shared Ser.g4 only defines structure keywords; vocabulary names are strings such as opaque vocabulary strings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["extractor", "version", "language", "find", "source", "take"],
  "properties": {
    "extractor": {
      "type": "string",
      "minLength": 1,
      "description": "Stable extractor id such as stable extractor ids defined by each implementation."
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "find": {
      "type": "array",
      "items": { "$ref": "#/$defs/vocabularyEntry" }
    },
    "source": {
      "type": "array",
      "items": { "$ref": "#/$defs/vocabularyEntry" }
    },
    "take": {
      "type": "array",
      "items": { "$ref": "#/$defs/vocabularyEntry" }
    },
    "when": {
      "type": "array",
      "items": { "$ref": "#/$defs/vocabularyEntry" }
    },
    "normalize": {
      "type": "array",
      "items": { "$ref": "#/$defs/vocabularyEntry" }
    },
    "traceTargets": {
      "type": "array",
      "items": { "$ref": "#/$defs/vocabularyEntry" }
    }
  },
  "$defs": {
    "vocabularyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "selectors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional selector forms accepted after this vocabulary word."
        },
        "takes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "For source/find entries, take names that make sense for the selected anchor."
        }
      }
    }
  }
}
